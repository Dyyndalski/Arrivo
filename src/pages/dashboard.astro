---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import Badge from "@/components/ui/Badge.astro";
import Card from "@/components/ui/Card.astro";
import { useTranslations } from "@/lib/i18n/t";

// Access is gated in src/middleware.ts (PROTECTED_ROUTES).
//
// No statistics tiles, unlike context/foundation/design/web/dashboard-specialist.html: "3 wizyty
// dziś" and "+22% vs poprzedni" need booking data, which arrives with S-04/S-05. A tile showing
// a hardcoded zero would be worse than no tile.
const { user, role, locale } = Astro.locals;
const t = useTranslations(locale);

const cards =
  role === "specialist"
    ? [
        {
          href: "/specialist/profile",
          title: t("dashboard.specialist.profile.title"),
          description: t("dashboard.specialist.profile.description"),
        },
        {
          href: "/specialist/services",
          title: t("dashboard.specialist.services.title"),
          description: t("dashboard.specialist.services.description"),
        },
      ]
    : [];
---

<Layout title={t("dashboard.title")}>
  <Topbar current="dashboard" />

  <main class="mx-auto w-full max-w-3xl px-6 py-10">
    <div class="mb-7 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-foreground font-display text-[26px]">{t("dashboard.title")}</h1>
        <p class="text-ink-soft mt-1 text-sm">
          {t("dashboard.greeting")}{user?.email ? `, ${user.email}` : ""}
        </p>
      </div>
      {role && <Badge variant={role}>{t(role === "client" ? "role.client" : "role.specialist")}</Badge>}
    </div>

    {
      cards.length > 0 ? (
        <div class="grid gap-3 sm:grid-cols-2">
          {cards.map((card) => (
            <a
              href={card.href}
              class="focus-visible:ring-ring/50 rounded-lg focus-visible:ring-[3px] focus-visible:outline-none"
            >
              <Card class="hover:border-border-strong h-full transition-colors">
                <p class="text-foreground text-[15px] font-bold">{card.title}</p>
                <p class="text-muted-foreground mt-1 text-[13px]">{card.description}</p>
              </Card>
            </a>
          ))}
        </div>
      ) : (
        // A client has nowhere to go until phase 5 ships /specialists and /account. Saying so
        // beats linking to a 404.
        <Card>
          <p class="text-foreground text-[15px] font-bold">{t("dashboard.client.discover.title")}</p>
          <p class="text-muted-foreground mt-1 text-[13px]">{t("dashboard.client.discover.description")}</p>
          <p class="text-muted-foreground mt-3 text-[13px] font-semibold">{t("common.soon")}</p>
        </Card>
      )
    }
  </main>
</Layout>
