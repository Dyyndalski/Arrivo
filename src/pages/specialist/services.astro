---
import SpecialistLayout from "@/layouts/SpecialistLayout.astro";
import Card from "@/components/ui/Card.astro";
import CardStatus from "@/components/specialist/CardStatus.astro";
import ServiceForm from "@/components/specialist/ServiceForm";
import ServiceList from "@/components/specialist/ServiceList.astro";
import { serviceFormStrings } from "@/components/specialist/strings";
import { createClient } from "@/lib/supabase";
import { getOwnCard, getTaxonomy, isDiscoverable, missingPieces } from "@/lib/services/specialists";
import { useTranslations, tUnknown, isMessageKey } from "@/lib/i18n/t";
import type { MissingPieceKey } from "@/lib/services/specialists";
import type { ServiceCategory, ServiceSubtype, SpecialistCard } from "@/types";

// Access is gated in src/middleware.ts (SPECIALIST_ROUTES).
const { user, locale } = Astro.locals;
const t = useTranslations(locale);
const supabase = createClient(Astro.request.headers, Astro.cookies);

let card: SpecialistCard = { profile: null, area_ids: [], services: [] };
let categories: ServiceCategory[] = [];
let subtypes: ServiceSubtype[] = [];
let discoverable = false;
let missing: MissingPieceKey[] = [];
let loadError: string | null = null;

if (!supabase) {
  loadError = t("specialist.error.notConfigured");
} else if (!user) {
  loadError = t("auth.error.sessionExpired");
} else {
  try {
    const [loadedCard, taxonomy, live] = await Promise.all([
      getOwnCard(supabase, user.id),
      getTaxonomy(supabase),
      isDiscoverable(supabase, user.id),
    ]);
    card = loadedCard;
    categories = taxonomy.categories;
    subtypes = taxonomy.subtypes;
    discoverable = live;
    missing = missingPieces(loadedCard);
  } catch {
    loadError = t("specialist.error.loadServices");
  }
}

const formError = Astro.url.searchParams.get("error");
const message = Astro.url.searchParams.get("message");
---

<SpecialistLayout
  title={t("specialist.services.title")}
  subtitle={t("specialist.services.subtitle")}
  current="services"
>
  <div class="space-y-5">
    {!loadError && <CardStatus discoverable={discoverable} missing={missing} />}

    {
      /* Only a recognised key renders — see the same note in profile.astro. Here the fallback
         was worse: it claimed a service had been ADDED, over a list that had not changed. */
      message && isMessageKey(message) && (
        <p class="bg-success-soft text-success-soft-text rounded-sm px-3.5 py-2.5 text-sm">{t(message)}</p>
      )
    }

    {
      loadError ? (
        <p class="bg-danger-soft text-danger rounded-md px-4 py-6 text-center text-sm">{loadError}</p>
      ) : (
        <>
          <ServiceList services={card.services} categories={categories} subtypes={subtypes} />

          <Card>
            <p class="text-foreground mb-4 text-[15px] font-bold">{t("specialist.services.add")}</p>
            <ServiceForm
              categories={categories}
              subtypes={subtypes}
              serverError={formError ? tUnknown(locale, formError, "specialist.error.addFailed") : null}
              locale={locale}
              strings={serviceFormStrings(locale)}
              client:load
            />
          </Card>
        </>
      )
    }
  </div>
</SpecialistLayout>
