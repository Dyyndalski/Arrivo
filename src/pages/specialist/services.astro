---
import Layout from "@/layouts/Layout.astro";
import ServiceForm from "@/components/specialist/ServiceForm";
import ServiceList from "@/components/specialist/ServiceList.astro";
import CardStatus from "@/components/specialist/CardStatus.astro";
import SpecialistNav from "@/components/specialist/SpecialistNav.astro";
import { createClient } from "@/lib/supabase";
import { getOwnCard, getTaxonomy, missingPieces } from "@/lib/services/specialists";
import type { ServiceCategory, ServiceSubtype, SpecialistCard } from "@/types";

// Access is gated in src/middleware.ts (SPECIALIST_ROUTES) — per CLAUDE.md, routes are not
// re-guarded here. The null check below is type narrowing, not an auth check.
const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let card: SpecialistCard = { profile: null, area_ids: [], services: [] };
let categories: ServiceCategory[] = [];
let subtypes: ServiceSubtype[] = [];
let loadError: string | null = null;

// Three distinct causes, three distinct messages (impl-review F2).
if (!supabase) {
  loadError = "Supabase is not configured";
} else if (!user) {
  loadError = "Your session has expired — sign in again";
} else {
  try {
    const [loadedCard, taxonomy] = await Promise.all([getOwnCard(supabase, user.id), getTaxonomy(supabase)]);
    card = loadedCard;
    categories = taxonomy.categories;
    subtypes = taxonomy.subtypes;
  } catch {
    loadError = "Could not load your services — refresh to try again";
  }
}

// A failed POST comes back as ?error= and belongs inside the form. A failed load replaces the
// form and the list entirely rather than rendering them empty.
const formError = Astro.url.searchParams.get("error");
const message = Astro.url.searchParams.get("message");
---

<Layout title="Your services">
  <div class="bg-cosmic min-h-screen p-4 py-10">
    <div class="mx-auto w-full max-w-2xl space-y-6">
      <SpecialistNav current="services" />

      <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Your services
      </h1>

      {!loadError && <CardStatus missing={missingPieces(card)} />}

      {
        message && (
          <p class="rounded-lg border border-emerald-500/30 bg-emerald-900/20 px-3 py-2 text-sm text-emerald-300">
            {message}
          </p>
        )
      }

      {
        loadError ? (
          <p class="rounded-2xl border border-red-500/30 bg-red-900/20 px-4 py-6 text-center text-sm text-red-300">
            {loadError}
          </p>
        ) : (
          <>
            <ServiceList services={card.services} categories={categories} subtypes={subtypes} />

            <div class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
              <h2 class="mb-4 text-sm font-medium text-blue-100/80">Add a service</h2>
              <ServiceForm categories={categories} subtypes={subtypes} serverError={formError} client:load />
            </div>
          </>
        )
      }
    </div>
  </div>
</Layout>
