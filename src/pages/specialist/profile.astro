---
import Layout from "@/layouts/Layout.astro";
import ProfileForm from "@/components/specialist/ProfileForm";
import CardStatus from "@/components/specialist/CardStatus.astro";
import SpecialistNav from "@/components/specialist/SpecialistNav.astro";
import { createClient } from "@/lib/supabase";
import { getOwnCard, getServiceAreas, missingPieces } from "@/lib/services/specialists";
import type { ServiceArea, SpecialistCard } from "@/types";

// Access is gated in src/middleware.ts (SPECIALIST_ROUTES) — per CLAUDE.md, routes are not
// re-guarded here. The null check below is type narrowing, not an auth check.
const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let card: SpecialistCard = { profile: null, area_ids: [], services: [] };
let areas: ServiceArea[] = [];
let loadError: string | null = null;

if (!supabase || !user) {
  loadError = "Supabase is not configured";
} else {
  try {
    [card, areas] = await Promise.all([getOwnCard(supabase, user.id), getServiceAreas(supabase)]);
  } catch {
    loadError = "Could not load your profile — refresh to try again";
  }
}

const error = Astro.url.searchParams.get("error") ?? loadError;
const message = Astro.url.searchParams.get("message");
---

<Layout title="Your profile">
  <div class="bg-cosmic min-h-screen p-4 py-10">
    <div class="mx-auto w-full max-w-2xl space-y-6">
      <SpecialistNav current="profile" />

      <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Your profile
      </h1>

      <CardStatus missing={missingPieces(card)} />

      {
        message && (
          <p class="rounded-lg border border-emerald-500/30 bg-emerald-900/20 px-3 py-2 text-sm text-emerald-300">
            {message}
          </p>
        )
      }

      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <ProfileForm
          areas={areas}
          initialName={card.profile?.display_name ?? ""}
          initialAreaIds={card.area_ids}
          serverError={error}
          client:load
        />
      </div>
    </div>
  </div>
</Layout>
