---
import SpecialistLayout from "@/layouts/SpecialistLayout.astro";
import Card from "@/components/ui/Card.astro";
import CardStatus from "@/components/specialist/CardStatus.astro";
import ProfileForm from "@/components/specialist/ProfileForm";
import { profileFormStrings } from "@/components/specialist/strings";
import { createClient } from "@/lib/supabase";
import { getAreaDictionary, getOwnCard, isDiscoverable, missingPieces } from "@/lib/services/specialists";
import { useTranslations, tUnknown, isMessageKey } from "@/lib/i18n/t";
import type { MissingPieceKey } from "@/lib/services/specialists";
import type { City, ServiceArea, SpecialistCard } from "@/types";

// Access is gated in src/middleware.ts (SPECIALIST_ROUTES) — per CLAUDE.md, routes are not
// re-guarded here. The null check below is type narrowing, not an auth check.
const { user, locale } = Astro.locals;
const t = useTranslations(locale);
const supabase = createClient(Astro.request.headers, Astro.cookies);

let card: SpecialistCard = { profile: null, area_ids: [], services: [] };
let cities: City[] = [];
let areas: ServiceArea[] = [];
let discoverable = false;
let missing: MissingPieceKey[] = [];
let loadError: string | null = null;

// Three distinct causes, three distinct messages (impl-review F2). Collapsing them told a
// specialist with a saved profile that Supabase was misconfigured.
if (!supabase) {
  loadError = t("specialist.error.notConfigured");
} else if (!user) {
  loadError = t("auth.error.sessionExpired");
} else {
  try {
    const [ownCard, dictionary, live] = await Promise.all([
      getOwnCard(supabase, user.id),
      getAreaDictionary(supabase),
      isDiscoverable(supabase, user.id),
    ]);
    card = ownCard;
    cities = dictionary.cities;
    areas = dictionary.areas;
    discoverable = live;
    missing = missingPieces(ownCard);
  } catch {
    loadError = t("specialist.error.loadProfile");
  }
}

// A failed POST comes back as ?error= and belongs INSIDE the form, next to the input that
// caused it. A failed load replaces the form entirely: rendering an empty one would show a
// blank name and no districts to someone who has both saved.
const formError = Astro.url.searchParams.get("error");
const message = Astro.url.searchParams.get("message");
---

<SpecialistLayout title={t("specialist.profile.title")} subtitle={t("specialist.profile.subtitle")} current="profile">
  <div class="space-y-5">
    {!loadError && <CardStatus discoverable={discoverable} missing={missing} />}

    {
      /* Only a recognised key renders. Unlike an error, where a generic fallback is honest
         because something did go wrong, a success fallback would assert that a specific thing
         succeeded — a hand-edited URL would show a green "Profile saved" over an unchanged form
         (phase-4 impl-review F3). */
      message && isMessageKey(message) && (
        <p class="bg-success-soft text-success-soft-text rounded-sm px-3.5 py-2.5 text-sm">{t(message)}</p>
      )
    }

    {
      loadError ? (
        <p class="bg-danger-soft text-danger rounded-md px-4 py-6 text-center text-sm">{loadError}</p>
      ) : (
        <Card>
          <ProfileForm
            cities={cities}
            areas={areas}
            initialName={card.profile?.display_name ?? ""}
            initialBio={card.profile?.bio ?? ""}
            initialAreaIds={card.area_ids}
            serverError={formError ? tUnknown(locale, formError, "specialist.error.saveFailed") : null}
            locale={locale}
            strings={profileFormStrings(locale)}
            client:load
          />
        </Card>
      )
    }
  </div>
</SpecialistLayout>
