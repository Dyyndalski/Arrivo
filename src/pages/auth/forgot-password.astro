---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/auth/AuthCard.astro";
import ForgotPasswordForm from "@/components/auth/ForgotPasswordForm";
import { authStrings } from "@/components/auth/strings";
import { useTranslations, tUnknown } from "@/lib/i18n/t";

const { locale } = Astro.locals;
const t = useTranslations(locale);

// Reached with ?error=auth.error.linkExpired when middleware bounces a reset attempt that has no
// recovery session.
const error = Astro.url.searchParams.get("error");

const strings = authStrings(locale, t("auth.forgot.submit"), t("auth.forgot.pending"));
---

<Layout title={t("auth.forgot.title")}>
  <AuthCard title={t("auth.forgot.title")} subtitle={t("auth.forgot.subtitle")}>
    <ForgotPasswordForm
      serverError={error ? tUnknown(locale, error, "auth.error.generic") : null}
      strings={strings}
      client:load
    />

    <p class="text-ink-soft mt-4 text-center text-[13px]">
      <a href="/auth/signin" class="text-primary font-semibold hover:underline">{t("auth.link.backToSignIn")}</a>
    </p>
  </AuthCard>
</Layout>
