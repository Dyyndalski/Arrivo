---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/auth/AuthCard.astro";
import { useTranslations } from "@/lib/i18n/t";

const { locale } = Astro.locals;
const t = useTranslations(locale);

// The local Supabase stack auto-confirms new accounts, so telling a developer to check an inbox
// that will never receive anything sends them looking for a bug that is not there.
const isAutoConfirmed = import.meta.env.DEV;

const title = isAutoConfirmed ? t("auth.confirmEmail.devTitle") : t("auth.confirmEmail.title");
const body = isAutoConfirmed ? t("auth.confirmEmail.devBody") : t("auth.confirmEmail.body");
---

<Layout title={title}>
  <AuthCard title={title}>
    <p class="text-ink-soft text-center text-sm leading-relaxed">{body}</p>

    <p class="mt-6 text-center text-[13px]">
      <a href="/auth/signin" class="text-primary font-semibold hover:underline">{t("nav.signIn")}</a>
    </p>
  </AuthCard>
</Layout>
