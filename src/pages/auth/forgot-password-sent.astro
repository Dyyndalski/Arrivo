---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/auth/AuthCard.astro";
import { useTranslations } from "@/lib/i18n/t";

// Reached unconditionally after a reset request, whether or not an account exists — the endpoint
// never branches, so the copy here must stay conditional ("if an account exists") rather than
// confirming that anything was sent.
const { locale } = Astro.locals;
const t = useTranslations(locale);
---

<Layout title={t("auth.forgotSent.title")}>
  <AuthCard title={t("auth.forgotSent.title")}>
    <p class="text-ink-soft text-center text-sm leading-relaxed">{t("auth.forgotSent.body")}</p>

    <p class="mt-6 text-center text-[13px]">
      <a href="/auth/signin" class="text-primary font-semibold hover:underline">{t("auth.link.backToSignIn")}</a>
    </p>
  </AuthCard>
</Layout>
