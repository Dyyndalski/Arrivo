---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/auth/AuthCard.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { authStrings } from "@/components/auth/strings";
import { useTranslations, tUnknown } from "@/lib/i18n/t";
import { MIN_PASSWORD_LENGTH } from "@/lib/schemas/limits";

const { locale } = Astro.locals;
const t = useTranslations(locale);

const error = Astro.url.searchParams.get("error");

const strings = authStrings(locale, t("auth.signUp.submit"), t("auth.signUp.pending"));
---

<Layout title={t("auth.signUp.submit")}>
  <AuthCard title={t("auth.signUp.title")} subtitle={t("auth.signUp.subtitle")} wide>
    <SignUpForm
      serverError={error ? tUnknown(locale, error, "auth.error.generic", { min: MIN_PASSWORD_LENGTH }) : null}
      strings={strings}
      client:load
    />

    <p class="text-ink-soft mt-4 text-center text-[13px]">
      {t("auth.link.haveAccount")}{" "}
      <a href="/auth/signin" class="text-primary font-semibold hover:underline">{t("nav.signIn")}</a>
    </p>
  </AuthCard>
</Layout>
