---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/auth/AuthCard.astro";
import SignInForm from "@/components/auth/SignInForm";
import { authStrings } from "@/components/auth/strings";
import { useTranslations, tUnknown } from "@/lib/i18n/t";
import { MIN_PASSWORD_LENGTH } from "@/lib/schemas/limits";

const { locale } = Astro.locals;
const t = useTranslations(locale);

// `?error=` and `?message=` carry catalog keys, not sentences. `tUnknown` resolves them and falls
// back to a generic message for anything it does not recognise — a stale bookmark or a
// hand-edited URL must not put attacker-chosen text where our own errors appear.
const error = Astro.url.searchParams.get("error");
const message = Astro.url.searchParams.get("message");
const email = Astro.url.searchParams.get("email");

const strings = authStrings(locale, t("auth.signIn.submit"), t("auth.signIn.pending"));
---

<Layout title={t("auth.signIn.submit")}>
  <AuthCard title={t("auth.signIn.title")} subtitle={t("auth.signIn.subtitle")}>
    {
      message && (
        <p class="bg-success-soft text-success-soft-text mb-4 rounded-sm px-3.5 py-2.5 text-center text-sm">
          {tUnknown(locale, message, "auth.message.passwordUpdated")}
        </p>
      )
    }

    <SignInForm
      serverError={error ? tUnknown(locale, error, "auth.error.generic", { min: MIN_PASSWORD_LENGTH }) : null}
      initialEmail={email ?? undefined}
      strings={strings}
      client:load
    />

    <p class="mt-3 text-center text-[13px]">
      <a href="/auth/forgot-password" class="text-primary font-semibold hover:underline">{t("auth.link.forgot")}</a>
    </p>

    <p class="text-ink-soft mt-4 text-center text-[13px]">
      {t("auth.link.noAccount")}{" "}
      <a href="/auth/signup" class="text-primary font-semibold hover:underline">{t("nav.signUp")}</a>
    </p>
  </AuthCard>
</Layout>
