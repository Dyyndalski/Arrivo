---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/auth/AuthCard.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";
import { authStrings } from "@/components/auth/strings";
import { useTranslations, tUnknown } from "@/lib/i18n/t";
import { MIN_PASSWORD_LENGTH } from "@/lib/schemas/limits";

// The recovery-session gate lives in middleware (src/middleware.ts): a direct visit
// without a recovery session is bounced to /auth/forgot-password before this renders.
const { locale } = Astro.locals;
const t = useTranslations(locale);

const error = Astro.url.searchParams.get("error");

const strings = authStrings(locale, t("auth.reset.submit"), t("auth.reset.pending"));
---

<Layout title={t("auth.reset.title")}>
  <AuthCard title={t("auth.reset.title")} subtitle={t("auth.reset.subtitle")}>
    <ResetPasswordForm
      serverError={error ? tUnknown(locale, error, "auth.error.generic", { min: MIN_PASSWORD_LENGTH }) : null}
      strings={strings}
      client:load
    />
  </AuthCard>
</Layout>
