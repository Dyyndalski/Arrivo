---
import { cn } from "@/lib/utils";

/**
 * The mockups' `.badge-*` set. The booking-status variants (pending/accepted/declined) have no
 * consumer until S-05 but are ported together so the vocabulary is defined once, in the same
 * place, rather than being invented twice.
 */
type Variant = "client" | "specialist" | "pending" | "accepted" | "completed" | "declined";

interface Props {
  variant: Variant;
  class?: string;
}

const VARIANTS: Record<Variant, string> = {
  client: "bg-teal-soft text-teal-soft-text",
  specialist: "bg-primary-soft text-primary-soft-text",
  pending: "bg-warning-soft text-warning",
  accepted: "bg-success-soft text-success-soft-text",
  completed: "bg-surface-alt text-ink-soft",
  declined: "bg-danger-soft text-danger",
};

const { variant, class: className } = Astro.props;
---

<span
  class:list={[
    cn(
      "inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11.5px] font-bold tracking-wide",
      VARIANTS[variant],
      className,
    ),
  ]}
>
  <slot />
</span>
