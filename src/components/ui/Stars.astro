---
import { cn } from "@/lib/utils";

interface Props {
  /** 0–5. Rounded to the nearest whole star for the glyphs; `label` carries the exact value. */
  value: number;
  /** Rendered next to the stars and used as the accessible text. Required — glyphs alone are
   *  aria-hidden, so without it a screen reader gets nothing at all. */
  label: string;
  class?: string;
}

const { value, label, class: className } = Astro.props;

const filled = Math.max(0, Math.min(5, Math.round(value)));
---

<span class:list={[cn("inline-flex items-center gap-1.5 text-sm", className)]}>
  <span class="text-warning tracking-widest" aria-hidden="true">
    {"★".repeat(filled)}{"☆".repeat(5 - filled)}
  </span>
  <span class="text-muted-foreground">{label}</span>
</span>
