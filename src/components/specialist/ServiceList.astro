---
import EmptyState from "@/components/ui/EmptyState.astro";
import { localizedName } from "@/lib/i18n/dictionary";
import { useTranslations } from "@/lib/i18n/t";
import type { Service, ServiceCategory, ServiceSubtype } from "@/types";

// No interactivity here — each row's remove button is a native form post, so this stays an
// Astro component rather than a React island.
interface Props {
  services: Service[];
  categories: ServiceCategory[];
  subtypes: ServiceSubtype[];
}

const { services, categories, subtypes } = Astro.props;
const { locale } = Astro.locals;
const t = useTranslations(locale);

const category = new Map(categories.map((c) => [c.id, c]));
const subtype = new Map(subtypes.map((s) => [s.id, s]));

// The specialist's own wording leads when they gave one; the taxonomy name is the fallback and
// stays visible underneath either way, because that is what the client's type filter matches on.
function headline(service: Service): string {
  if (service.name) return service.name;
  const c = category.get(service.category_id);
  return c ? localizedName(c, locale) : "—";
}

function taxonomyLine(service: Service): string {
  const c = category.get(service.category_id);
  const s = service.subtype_id === null ? null : subtype.get(service.subtype_id);
  const parts = [c ? localizedName(c, locale) : null, s ? localizedName(s, locale) : null].filter(Boolean);
  return parts.join(" · ");
}

// Prices are integer grosze; render with a comma, which is how Polish prices are written.
const formatPrice = (cents: number) =>
  `${(cents / 100).toLocaleString("pl-PL", { minimumFractionDigits: 2, maximumFractionDigits: 2 })} zł`;
---

{
  services.length === 0 ? (
    <EmptyState title={t("specialist.services.empty")} />
  ) : (
    <ul class="space-y-3">
      {services.map((service) => (
        <li class="border-border bg-card flex items-center gap-4 rounded-md border px-4 py-3.5">
          <div class="min-w-0 flex-1">
            <p class="text-foreground truncate text-[14.5px] font-semibold">{headline(service)}</p>
            <p class="text-muted-foreground truncate text-[12.5px]">
              {taxonomyLine(service)}
              {service.duration_minutes !== null &&
                ` · ${t("specialist.services.duration", { minutes: service.duration_minutes })}`}
            </p>
          </div>

          <span class="text-foreground shrink-0 font-bold">{formatPrice(service.price_cents)}</span>

          <form method="POST" action={`/api/specialist/services/${service.id}/delete`}>
            <button
              type="submit"
              class="border-border-strong text-ink-soft hover:border-danger hover:text-danger cursor-pointer rounded-sm border px-3 py-1.5 text-[13px] font-semibold transition-colors"
              aria-label={t("specialist.services.removeLabel", { name: headline(service) })}
            >
              {t("specialist.services.remove")}
            </button>
          </form>
        </li>
      ))}
    </ul>
  )
}
