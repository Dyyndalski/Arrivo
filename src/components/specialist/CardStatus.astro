---
import { useTranslations } from "@/lib/i18n/t";
import type { MissingPieceKey } from "@/lib/services/specialists";

/**
 * Two sources, on purpose (S-02 impl-review F4, closed in phase 4).
 *
 * `discoverable` comes from `public.discoverable_specialists` — the SAME view the client-facing
 * search reads, so "your card is live" and "a client can find you" are one statement rather than
 * two implementations that can drift.
 *
 * `missing` comes from `missingPieces()`, which the view cannot express: it answers yes/no, and a
 * specialist told only "not visible" has no way to act.
 *
 * The two are rendered INDEPENDENTLY, and that is the load-bearing detail. The headline follows
 * the view; the list of missing pieces appears whenever it is non-empty, whatever the view said.
 * So a disagreement — which is reachable, since the page issues `getOwnCard()` and
 * `isDiscoverable()` as two separate round trips and a service can be deleted between them —
 * shows up as "your card is live" sitting above a list of things it is missing. Incoherent on
 * purpose. Branching the list on `discoverable` would have hidden exactly the direction that
 * costs a specialist their bookings (phase-4 impl-review F1).
 */
interface Props {
  discoverable: boolean;
  missing: MissingPieceKey[];
}

const { discoverable, missing } = Astro.props;
const { locale } = Astro.locals;
const t = useTranslations(locale);

const missingText = missing.map((key) => t(key)).join(", ");
---

<div
  class:list={[
    "flex items-start gap-3 rounded-md px-4 py-3 text-sm",
    discoverable ? "bg-success-soft text-success-soft-text" : "bg-warning-soft text-warning",
  ]}
>
  <span class="mt-0.5 shrink-0" aria-hidden="true">{discoverable ? "●" : "○"}</span>
  <div>
    <p class="font-semibold">
      {discoverable ? t("specialist.card.liveTitle") : t("specialist.card.incompleteTitle")}
    </p>

    {discoverable && <p class="opacity-80">{t("specialist.card.liveBody")}</p>}

    {/* Not `: ` — an empty list would render "Still needed: ." with nothing before the period. */}
    {missing.length > 0 && <p class="opacity-80">{t("specialist.card.incompleteBody", { missing: missingText })}</p>}
  </div>
</div>
