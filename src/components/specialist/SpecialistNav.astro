---
interface Props {
  current: "profile" | "services";
}

const { current } = Astro.props;

const links = [
  { key: "profile", href: "/specialist/profile", label: "Profile" },
  { key: "services", href: "/specialist/services", label: "Services" },
] as const;
---

<nav class="flex items-center gap-2 text-sm">
  <a href="/dashboard" class="text-blue-100/50 transition-colors hover:text-blue-100">← Dashboard</a>
  <span class="text-white/20">|</span>
  {
    links.map((link) => (
      <a
        href={link.href}
        aria-current={current === link.key ? "page" : undefined}
        class:list={[
          "rounded-lg px-2.5 py-1 transition-colors",
          current === link.key
            ? "bg-white/15 font-medium text-white"
            : "text-blue-100/60 hover:bg-white/10 hover:text-blue-100",
        ]}
      >
        {link.label}
      </a>
    ))
  }
</nav>
