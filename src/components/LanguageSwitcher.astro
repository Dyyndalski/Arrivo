---
import { LOCALES } from "@/lib/i18n";
import { useTranslations } from "@/lib/i18n/t";
import { cn } from "@/lib/utils";

/**
 * A form, not a client island: switching language must work with no JavaScript, and the target
 * persona includes people on slow or old devices. One submit button per locale keeps it to plain
 * HTML.
 *
 * `redirectTo` carries the current path so the switch lands the visitor back where they were
 * rather than on the home page. The endpoint validates it before redirecting.
 *
 * The pills were `px-2 py-0.5`, which rendered a 20px-tall target — under the 24px WCAG 2.2
 * minimum. Enlarged with real padding rather than a transparent overlay: the two buttons sit 4px
 * apart, and overlapping hit areas would make the wrong language easy to press, which is worse
 * than a small target. The pill grows a few pixels; nothing else in the header moves.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const { locale } = Astro.locals;
const t = useTranslations(locale);

const here = Astro.url.pathname + Astro.url.search;
---

<form
  method="POST"
  action="/api/locale"
  class:list={[cn("flex items-center gap-1", className)]}
  aria-label={t("language.label")}
>
  <input type="hidden" name="redirectTo" value={here} />
  {
    LOCALES.map((code) => {
      const active = code === locale;
      return (
        <button
          type="submit"
          name="locale"
          value={code}
          aria-current={active ? "true" : undefined}
          aria-label={active ? undefined : t("language.switchTo", { language: t(`language.${code}`) })}
          class:list={[
            "inline-flex min-h-6 items-center rounded-full px-2.5 py-1 text-xs font-semibold uppercase transition-colors",
            active ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground cursor-pointer",
          ]}
        >
          {code}
        </button>
      );
    })
  }
</form>
