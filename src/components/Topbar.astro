---
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { useTranslations } from "@/lib/i18n/t";

/**
 * Still on the starter's dark palette: this renders inside Welcome's `bg-cosmic` wrapper, which
 * phase 3 retires. Only the strings and the language switcher change here — the mockups' navbar
 * (context/foundation/design/web/discover.html) arrives with that retrofit.
 */
const { user, locale } = Astro.locals;
const t = useTranslations(locale);
---

<div
  class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80"
>
  {
    user ? (
      <>
        <span class="text-blue-100/70">{user.email}</span>
        <div class="flex items-center gap-3">
          <LanguageSwitcher tone="inverse" />
          <a href="/dashboard" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            {t("nav.dashboard")}
          </a>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="cursor-pointer text-purple-300 transition-colors hover:text-purple-100 hover:underline"
            >
              {t("nav.signOut")}
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-blue-100/70">{t("nav.signedOut")}</span>
        <div class="flex items-center gap-3">
          <LanguageSwitcher tone="inverse" />
          <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            {t("nav.signIn")}
          </a>
          <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            {t("nav.signUp")}
          </a>
        </div>
      </>
    )
  }
</div>
