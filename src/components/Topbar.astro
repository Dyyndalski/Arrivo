---
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import Wordmark from "@/components/Wordmark.astro";
import Avatar from "@/components/ui/Avatar.astro";
import { useTranslations } from "@/lib/i18n/t";
import { homeFor } from "@/lib/routes";
import { cn } from "@/lib/utils";

/**
 * The mockups' `.navbar` (context/foundation/design/web/discover.html).
 *
 * Links are role-aware, and destinations that do not exist yet are OMITTED rather than disabled:
 * an empty nav slot is invisible, a dead nav link is not. Client bookings arrive with S-04;
 * /specialists and /account with phase 5.
 */
interface Props {
  current?: "discover" | "bookings" | "profile" | "services" | "dashboard";
  class?: string;
}

const { current, class: className } = Astro.props;
const { user, role, locale } = Astro.locals;
const t = useTranslations(locale);

const links: { href: string; label: string; key: NonNullable<Props["current"]> }[] = [];

// Discovery is public, so it is offered to signed-out visitors too — that is the page the PRD
// wants a first-time visitor to land on.
links.push({ href: "/specialists", label: t("nav.discover"), key: "discover" });

if (user) {
  links.push({ href: "/dashboard", label: t("nav.dashboard"), key: "dashboard" });
  if (role === "client") {
    // The slot S-03 deliberately left empty rather than filling with a dead link.
    links.push({ href: "/account/bookings", label: t("bookings.title"), key: "bookings" });
    links.push({ href: "/account/profile", label: t("nav.profile"), key: "profile" });
  }
  if (role === "specialist") {
    // The specialist half of that same slot, filled by S-05 once its buttons could do something.
    // The mockup puts this in a vertical sidebar; that layout is a change of its own, and part of
    // it ("Zespół") has no requirement behind it at all.
    links.push({ href: "/specialist/bookings", label: t("specialist.bookings.nav"), key: "bookings" });
    // Profile and services were reachable only through /dashboard, which was fine while the
    // dashboard was where a specialist landed. Now that `homeFor()` opens the inbox instead, the
    // two setup screens need their own nav entries or the landing page is a cul-de-sac.
    links.push({ href: "/specialist/services", label: t("nav.services"), key: "services" });
    links.push({ href: "/specialist/profile", label: t("nav.profile"), key: "profile" });
  }
}
---

<header class:list={[cn("border-border bg-card flex items-center justify-between border-b px-6 py-3.5", className)]}>
  {
    /* The wordmark means "home", and home is now the role's own screen — the same target `/`
      dispatches to. Signed out it points at `/`, which redirects to sign-in. */
  }
  <a href={user ? homeFor(role) : "/"} class="shrink-0"><Wordmark /></a>

  {
    links.length > 0 && (
      <nav class="hidden items-center gap-7 text-sm font-medium sm:flex" aria-label={t("nav.dashboard")}>
        {links.map((link) => (
          <a
            href={link.href}
            aria-current={current === link.key ? "page" : undefined}
            class:list={[
              "transition-colors",
              current === link.key ? "text-foreground font-semibold" : "text-ink-soft hover:text-foreground",
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>
    )
  }

  <div class="flex items-center gap-3">
    <LanguageSwitcher />
    {
      user ? (
        <>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="text-ink-soft hover:text-foreground cursor-pointer text-sm font-medium transition-colors"
            >
              {t("nav.signOut")}
            </button>
          </form>
          <Avatar name={user.email ?? null} size="sm" />
        </>
      ) : (
        <>
          <a href="/auth/signin" class="text-ink-soft hover:text-foreground text-sm font-medium transition-colors">
            {t("nav.signIn")}
          </a>
          <a
            href="/auth/signup"
            class="bg-primary hover:bg-primary-dark rounded-sm px-3.5 py-2 text-sm font-semibold text-white transition-colors"
          >
            {t("nav.signUp")}
          </a>
        </>
      )
    }
  </div>
</header>
